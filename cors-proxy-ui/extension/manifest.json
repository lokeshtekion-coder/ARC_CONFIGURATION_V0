{
  "manifest_version": 3,
  "name": "ARC Token Sync",
  "version": "1.4.0",
  "description": "Local ARC helper extension with pure network-layer capture.",
  "permissions": [
    "storage",
    "tabs",
    "webRequest",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ARC Helper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://tap.tekioncloud.com/*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ]
}