{
  "manifest_version": 3,
  "name": "ARC Token Sync",
  "version": "0.1.0",
  "description": "Local ARC helper extension.",
  "permissions": ["storage", "tabs", "webRequest"],
  "host_permissions": [
    "https://graph.microsoft.com/v1.0/*",
    "https://us-west1-tapapi.tekioncloud.com/*",
    "https://preprodapp.tekioncloud.com/*",
    "https://tap.tekioncloud.com/*",
    "https://webshell.suite.office.com/*",
    "http://localhost:5174/*",
    "http://127.0.0.1:5174/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ARC Helper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5174/*",
        "http://127.0.0.1:5174/*",
        "https://tap.tekioncloud.com/*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ]
}
